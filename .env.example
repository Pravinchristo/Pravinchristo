# Copy to .env and fill in. Never commit .env.

# Required: your Claude API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Recommended: Telegram, so you can message the agent from your phone and get its notifications.
# 1. In Telegram, message @BotFather, send /newbot, and paste the token here.
# 2. Start the agent, message your bot once, and it replies with the chat id to put below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
AGENT_TIMEZONE=Asia/Kolkata
AGENT_REFLECT_AT=21:00
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
